*.min.css
*.min.js
www/
android/
node_modules/
.idea/

# Memoria/estado del agente Reasonix (cambia solo, no es código fuente)
reasonix.toml
.reasonix/

# Capturas de depuración visual (evidencia temporal, no código fuente)
scripts/*.png

# Fotos de estilos calculados (evidencia temporal de un refactor, se regeneran)
scripts/foto-*.json

# Copias de seguridad que dejan los transformadores de CSS
css/*.antes-de-capar
css/*.antes-de-mover
css/*.antes-de-quitar

# Copias de seguridad de los scripts de codificacion/adopcion
js/*.antes-de-adoptar
js/*.antes-de-codificar

# Salidas temporales de verificar-todo.mjs y de las corridas de verificadores
scripts/.tmp-*
scripts/*.out.txt
scripts/t[0-9].txt
scripts/tmp-*.mjs

# Salidas de la foto de estilos y su registro de lo no medido (se generan, no se versionan)
scripts/f-*.json
scripts/*.sin-medir.json
